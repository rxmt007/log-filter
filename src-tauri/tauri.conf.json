{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LogFilter",
  "version": "0.1.0",
  "identifier": "io.github.rxmt007.logfilter",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LogFilter",
        "width": 1180,
        "height": 720,
        "minWidth": 960,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "deb"],
    "publisher": "rxmt007",
    "shortDescription": "Cross-platform Android logcat viewer",
    "longDescription": "LogFilter is a cross-platform desktop Android logcat viewer with mmap-backed indexing, filtering, search, live adb capture, export, and log splitting.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
