{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LogFilter",
  "version": "0.1.1",
  "identifier": "io.github.rxmt007.logfilter",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LogFilter",
        "width": 1180,
        "height": 720,
        "minWidth": 960,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "deb"],
    "publisher": "rxmt007",
    "homepage": "https://github.com/rxmt007/log-filter",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "resources": {
      "../COPYRIGHT": "COPYRIGHT",
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../third-party-licenses/Geist-OFL-1.1.txt": "third-party-licenses/Geist-OFL-1.1.txt",
      "../third-party-licenses/Rust-dependencies.html": "third-party-licenses/Rust-dependencies.html",
      "../third-party-licenses/pnpm-production-dependencies.txt": "third-party-licenses/pnpm-production-dependencies.txt"
    },
    "shortDescription": "Cross-platform Android logcat viewer",
    "longDescription": "LogFilter is a cross-platform desktop Android logcat viewer with mmap-backed indexing, filtering, search, live adb capture, export, and log splitting.",
    "macOS": {
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 190
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 190
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
